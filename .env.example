# ============================================================================
# Copy to .env.local for local development. In production set the same keys in
# Vercel → Project → Settings → Environment Variables.
# ============================================================================

# --- Supabase: Project settings → Database → Connection string --------------
# Use the SESSION POOLER string — the pooler host on port 5432.
# Replace [YOUR-PASSWORD] with your database password.
#
# Do NOT use the transaction pooler (port 6543). This app's Postgres client
# pipelines queries, which transaction mode cannot interleave safely: past two
# concurrent queries it stalls instead of erroring. Same host, same password,
# just the other port.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# --- Supabase: Project settings → API ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Your site --------------------------------------------------------------
# Canonical URLs, sitemap and share cards. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Optional ---------------------------------------------------------------
# Connections per instance. The default suits a portfolio; raise it only if
# pages start queueing under real traffic.
# DB_POOL_MAX=3
