# ============================================================================
# Copy to .env.local for local development. In production set the same keys in
# Vercel → Project → Settings → Environment Variables.
# ============================================================================

# --- Supabase: Project settings → Database → Connection string --------------
# Use the TRANSACTION POOLER string — the pooler host on port 6543.
# Replace [YOUR-PASSWORD] with your database password.
#
# The session pooler string (port 5432) also works: the app switches it to
# 6543 on its own, since serverless instances exhaust session mode. Query
# pipelining is turned off in lib/db, which is what makes 6543 safe.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# --- Supabase: Project settings → API ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Your site --------------------------------------------------------------
# Canonical URLs, sitemap and share cards. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Optional ---------------------------------------------------------------
# Connections per instance. The default (4) suits a portfolio; raise it only
# if pages start queueing under real traffic.
# DB_POOL_MAX=4
# Keep a session-pooler (5432) URL as-is instead of switching to 6543.
# DB_KEEP_PORT=1
